<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0F1013</item>
        <item name="android:statusBarColor">#0F1013</item>
        <item name="android:windowBackground">#0F1013</item>
        <item name="android:colorAccent">#FF0033</item>
        <item name="android:alertDialogTheme">@style/YtmAlertDialogTheme</item>
        <item name="android:buttonStyle">@style/YtmButtonBase</item>
    </style>

    <style name="YtmButtonBase" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="YtmAlertDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_ytm_dialog</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:textColorPrimary">@color/app_text</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/YtmDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/YtmDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/YtmDialogButton</item>
    </style>

    <style name="YtmDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/app_accent</item>
    </style>
</resources>
